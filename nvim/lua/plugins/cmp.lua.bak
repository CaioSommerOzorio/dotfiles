return {
  {
    "hrsh7th/nvim-cmp",
    opts = function(_, opts)
      local cmp = require("cmp")

      -- 1. TURN OFF AUTOMATIC POPUPS
      opts.completion = {
        autocomplete = false, -- Stops the popup list from showing up as you type
      }

      -- 2. HIDE THE BIG DOCUMENTATION TEXT WINDOW
      opts.window = {
        documentation = cmp.config.disable, -- Completely removes the side doc window
      }

      -- 3. OPTIONAL: MANUALLY TRIGGER IT WHEN YOU ACTUALLY WANT IT
      -- This binds Ctrl + Space to open the menu only when you ask for it
      opts.mapping = vim.tbl_deep_extend("force", opts.mapping or {}, {
        ["<C-Space>"] = cmp.mapping.complete(),
      })
    end,
  },
}
